[135.622169, "o", "\r\n\u001b[1;33m# 3. The same agent tries 0.25 TAZ to the counter, over the per-payment cap: 2\u001b[0m\r\n"]
[137.625688, "o", "\u001b[1;36m$ npx tsx src/cli.ts pay utest1u2gz0d9qzns9j7nlkn8e5skmafsxs22glx4sxtr89mc5cd8v8ycrmtflpnf2t0jx2pu89j4u4ada8adsy4zne9jg5dv07yemv0tn2gth32mwna2nnraaxnc0d3yg9gmt49k9m0x33puzpj8dcuvd09w8g9h2k4lzwn8fel4uqux9q59y 25000000 --memo IRON-deadbeef airtel-india 5000 919999999999\u001b[0m\r\n"]
