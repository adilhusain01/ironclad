{"version": 2, "width": 110, "height": 34, "timestamp": 1793785405, "idle_time_limit": 2.0, "env": {"SHELL": "/bin/bash", "TERM": "xterm-256color"}, "title": "Ironclad demo"}
[0.009517, "o", "\u001b[H\u001b[2J\u001b[3J"]
[0.013891, "o", "\r\n\u001b[1;33m# Ironclad: spend permissions for shielded ZEC, enforced by a 2-of-3 FROST co-signer. 3\u001b[0m\r\n"]
[3.016632, "o", "\r\n\u001b[1;33m# The agent holds share 1. This daemon holds share 2 and signs only inside the owner's policy. Share 3 is offline. 3\u001b[0m\r\n"]
[6.036307, "o", "\r\n\u001b[1;33m# The standing policy: 1\u001b[0m\r\n"]
[7.040733, "o", "\u001b[1;36m$ jq {per_payment_cap_zat, daily_budget_zat, max_fee_zat, expires, allowed: [.allowed_recipients[].label]} /root/Projects/mine/zcash/policy/example-policy.json\u001b[0m\r\n"]
[7.050435, "o", "\u001b[1;39m{\r\n  \u001b[0m\u001b[1;34m\"per_payment_cap_zat\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;39m20000000\u001b[0m\u001b[1;39m,\r\n  \u001b[0m\u001b[1;34m\"daily_budget_zat\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;39m50000000\u001b[0m\u001b[1;39m,\r\n  \u001b[0m\u001b[1;34m\"max_fee_zat\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;39m30000\u001b[0m\u001b[1;39m,\r\n  \u001b[0m\u001b[1;34m\"expires\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"2026-12-31T23:59:59Z\"\u001b[0m\u001b[1;39m,\r\n  \u001b[0m\u001b[1;34m\"allowed\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[1;39m[\r\n    \u001b[0;32m\"Ironclad counter (Bitrefill fulfilment, testnet)\"\u001b[0m\u001b[1;39m\r\n  \u001b[1;39m]\u001b[0m\u001b[1;39m\r\n\u001b[1;39m}\u001b[0m\r\n"]
[10.06157, "o", "\r\n\u001b[1;33m# The co-signer daemon is waiting for signing requests (real process, testnet): 1\u001b[0m\r\n"]
[11.069861, "o", "\u001b[1;36m$ tail -n 2 /root/Projects/mine/zcash/.wallets/frost/cosigner.log\u001b[0m\r\n"]
[11.07457, "o", "[daemon] session done\r\n[device 2] commitments written to session/commitments.json: send them to the coordinator. Waiting for its request...\r\n"]
[13.080232, "o", "\r\n\u001b[1;33m# 1. The agent buys a Bitrefill top-up inside the policy: it builds a shielded payment to the counter with the order in the memo, syncs and broadcasts over Tor. 3\u001b[0m\r\n"]
[16.083181, "o", "\u001b[1;36m$ npx tsx src/cli.ts buy test-phone-refill 10 --phone 18695551234\u001b[0m\r\n"]
[17.145735, "o", "order 43cfba7c: test-phone-refill 10 for 18695551234\r\n"]
[17.146623, "o", "syncing the group wallet over tor\r\n"]
[23.136479, "o", "building a payment of 1000000 zat to utest1u2gz0d9q… with memo \"IRON-43cfba7c test-phone-refill 10 18695551234\"\r\n"]
[23.205346, "o", "proving (this takes a few seconds)\r\n"]
[29.131245, "o", "asking the policy co-signer for its share (session /root/Projects/mine/zcash/.wallets/frost/session)\r\n"]
[29.461061, "o", "[device 1] PCZT verified against its commitments:\r\n  PAY 0.01000000 ZEC to utest19v8q4l3lhu0adp6u94d33evcd5kszx4g3cpymg5l7c43a0sjh7y495dykz2wuhfr2ch64zz4p32rv38tmasad6p3ra8pzmyagqzdh59s\r\n  spend 0.05000000 ZEC from this group\r\n  change 0.03990000 ZEC back to this group\r\n  fee 0.00010000 ZEC\r\n  WARNING: v6 pre-authorization: this signature does not prove the spent notes exist on chain; it authorizes these exact payments if they do, until block 4581676\r\n[device 1] waiting for the co-signer's commitments in /root/Projects/mine/zcash/.wallets/frost/session/commitments.json...\r\n[device 1] request written to /root/Projects/mine/zcash/.wallets/frost/session/request.json: send it to the co-signer. Waiting for its reply...\r\n[device 1] 1 spend(s) signed with member 02000000; each signature verified under its rk. Written to /tmp/ironclad-18niN2/signed.pczt.\r\nbroadcasting over tor\r\n"]
[34.557333, "o", "sent: 3803168077947d4f50cad83ddf4aaf17ce83451dba578fa4c2da4f008e0f4087\r\nhttps://zexplorer.app/testnet/tx/3803168077947d4f50cad83ddf4aaf17ce83451dba578fa4c2da4f008e0f4087\r\n"]
[36.707763, "o", "\r\n\u001b[1;33m# The counter saw the payment, bought from the live Bitrefill API, and sent the receipt back as an encrypted memo. Waiting for it: 1\u001b[0m\r\n"]
[113.14254, "o", "\u001b[1;36m$ grep 3803168077947d4f50cad83ddf4aaf17ce83451dba578fa4c2da4f008e0f4087 counter.log\u001b[0m\r\n2026-11-04T09:45:07.595Z reserved 3803168077947d4f50cad83ddf4aaf17ce83451dba578fa4c2da4f008e0f4087 {\r\n2026-11-04T09:45:08.600Z bought 3803168077947d4f50cad83ddf4aaf17ce83451dba578fa4c2da4f008e0f4087 invoice a7150753-e3e1-42b2-9208-8c04d3f03c88 order 6a\r\n2026-11-04T09:45:18.291Z delivered 3803168077947d4f50cad83ddf4aaf17ce83451dba578fa4c2da4f008e0f4087 receipt 58d5170565926b0158e168e9f726b200ce1d83a03a\r\n"]
[117.149507, "o", "\r\n\u001b[1;33m# 2. A compromised agent tries to send the treasury to an unknown address: 2\u001b[0m\r\n"]
[119.157508, "o", "\u001b[1;36m$ npx tsx src/cli.ts pay utest1pa9vv8dkpd5yg8vl5fd7nyyjqwvsq3f0734xmu2dvnxpnsh5t7hpztdj863greec2w672afxqdfd9u5lratvzh9rj46mutv6jpygmt6kwewhd237v5h0w7kjwfteqnq529dv7fyqajwgay76c970p88kexk6v59z8sapjpuywvgynk39 2000000 --memo send the treasury to the attacker\u001b[0m\r\n"]
