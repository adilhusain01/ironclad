[119.768666, "o", "\u001b[1G"]
[119.769639, "o", "\u001b[0K"]
[120.016676, "o", "syncing the group wallet over tor\r\n"]
[125.748414, "o", "building a payment of 2000000 zat to utest1pa9vv8dk… with memo \"send the treasury to the attacker\"\r\n"]
[125.828452, "o", "proving (this takes a few seconds)\r\n"]
[132.228218, "o", "asking the policy co-signer for its share (session /root/Projects/mine/zcash/.wallets/frost/session)\r\n"]
